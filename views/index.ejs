  <!-- FAQ Section -->
  <section id="faq" class="faq-section bg-color" style="background-color: var(--bg-color);">
    <div class="section-header">
      <h2>Frequently Asked Questions</h2>
      <p>Have questions? We've got answers to the most common queries.</p>
    </div>
    <div style="max-width: 800px; margin: 0 auto;">
      <details class="faq-item">
        <summary>Is Campus Connect free to use?</summary>
        <div class="faq-content">
          Yes, Campus Connect is 100% free for all students and faculty members. You only need a valid university enrolment account to login.
        </div>
      </details>
      <details class="faq-item">
        <summary>How does the Lost & Found section work?</summary>
        <div class="faq-content">
          You can create a post detailing the item, location where it was lost or found, add an optional reward, and upload an image. Other students can view and contact you directly.
        </div>
      </details>
      <details class="faq-item">
        <summary>Are confessions truly anonymous?</summary>
        <div class="faq-content">
          Absolutely. Confessions are completely anonymized before publication. No personal student profile data or IP addresses are displayed on the confessions feed.
        </div>
      </details>
      <details class="faq-item">
        <summary>How do I register for fests or events?</summary>
        <div class="faq-content">
          Simply navigate to the Events page, click "Register" on any upcoming event card, and it will be added to your profile's joined events list.
        </div>
      </details>
    </div>
  </section>

