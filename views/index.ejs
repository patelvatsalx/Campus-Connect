  <!-- Features Section -->
  <section id="features" class="features-section">
    <div class="section-header">
      <h2>Core Modules</h2>
      <p>Clean and interactive modules designed to simplify daily student life on campus.</p>
    </div>
    <div class="grid grid-3">
      <div class="card-modern">
        <i class="fa-solid fa-magnifying-glass text-warning mb-3" style="font-size: 2.25rem;"></i>
        <h3 class="mb-2">Lost & Found Portal</h3>
        <p class="text-muted" style="font-size: 0.9rem;">
          Lost your calculator, keys, or lab coat? Post objects in our Pinterest-style board to track and return assets instantly.
        </p>
        <a href="/lost" class="text-primary font-weight-600 mt-auto pt-3" style="font-size: 0.85rem;">Browse Items &rarr;</a>
      </div>
      <div class="card-modern">
        <i class="fa-solid fa-calendar-days text-accent mb-3" style="font-size: 2.25rem;"></i>
