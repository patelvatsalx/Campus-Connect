<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Dashboard - Campus Connect</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="css/style.css">
  <link rel="stylesheet" href="css/pages.css">
  <link rel="stylesheet" href="css/responsive.css">
</head>
<body>
  <div class="app-container">
    <input type="checkbox" id="sidebar-toggle" class="sidebar-toggle" hidden>

    <aside class="sidebar">
      <div class="sidebar-header">
        <a href="/" class="sidebar-brand">
          <i class="fa-solid fa-graduation-cap"></i>
          <span>Campus Connect</span>
        </a>
        <label for="sidebar-toggle" class="sidebar-menu-btn">
          <i class="fa-solid fa-bars-staggered"></i>
        </label>
      </div>
      <ul class="sidebar-nav">
        <li class="sidebar-item active">
          <a href="/dashboard">
            <i class="fa-solid fa-chart-pie"></i>
            <span>Dashboard</span>
          </a>
        </li>
        <li class="sidebar-item">
          <a href="/lost">
            <i class="fa-solid fa-magnifying-glass"></i>
            <span>Lost & Found</span>
          </a>
        </li>
        <li class="sidebar-item">
          <a href="events.html">
            <i class="fa-solid fa-calendar-days"></i>
            <span>Events</span>
          </a>
        </li>
        <li class="sidebar-item">
          <a href="/confessions">
            <i class="fa-solid fa-user-secret"></i>
            <span>Confessions</span>
          </a>
        </li>
        <li class="sidebar-item" style="margin-top: auto; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 0.5rem;">
          <a href="settings.html">
            <i class="fa-solid fa-gear"></i>
            <span>Settings</span>
          </a>
        </li>
      </ul>
    </aside>

    <div class="main-layout">
      <header class="navbar">
        <div class="flex align-center gap-2">
          <label for="sidebar-toggle" class="sidebar-menu-btn" style="color: var(--text-dark); display: block; margin-right: 0.5rem;">
            <i class="fa-solid fa-bars"></i>
          </label>
          <div class="nav-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" placeholder="Search lost items, events, confessions...">
          </div>
        </div>
        <div class="nav-actions">
          <a href="404.html" class="nav-icon-btn">
            <i class="fa-regular fa-bell"></i>
            <span class="badge-dot"></span>
          </a>
          <div class="profile-dropdown">
            <input type="checkbox" id="profile-menu-toggle" class="dropdown-toggle" hidden>
            <label for="profile-menu-toggle" class="profile-trigger">
              <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=100" alt="Profile" class="profile-avatar">
              <div class="profile-info">
                <span class="profile-name">Priya Sharma</span>
                <span class="profile-role">CSE • Semester 6</span>
              </div>
              <i class="fa-solid fa-chevron-down" style="font-size: 0.75rem; color: var(--text-light);"></i>
            </label>
            <div class="dropdown-menu">
              <a href="profile.html" class="dropdown-item">
                <i class="fa-regular fa-user"></i>
                <span>My Profile</span>
              </a>
              <a href="settings.html" class="dropdown-item">
                <i class="fa-solid fa-gears"></i>
                <span>Account Settings</span>
              </a>
              <div class="dropdown-divider"></div>
              <a href="/" class="dropdown-item text-danger">
                <i class="fa-solid fa-right-from-bracket" style="color: var(--danger-color);"></i>
                <span>Sign Out</span>
              </a>
            </div>
          </div>
        </div>
      </header>

      <main class="content animate-fade-in">
        <div class="page-header">
          <div class="page-title">
            <h1>Campus Portal</h1>
            <p>Welcome back, Priya. Let's catch up on the college activities.</p>
          </div>
        </div>

        <div class="quick-actions-container">
          <a href="/lost" class="quick-action-btn">
            <i class="fa-solid fa-tag"></i>
            <span class="font-weight-600" style="font-size: var(--font-size-sm); color: var(--text-dark);">Report Lost/Found</span>
          </a>
          <a href="/confessions" class="quick-action-btn">
            <i class="fa-solid fa-user-secret"></i>
            <span class="font-weight-600" style="font-size: var(--font-size-sm); color: var(--text-dark);">Post Confession</span>
          </a>
          <a href="events.html" class="quick-action-btn">
            <i class="fa-solid fa-calendar-day"></i>
            <span class="font-weight-600" style="font-size: var(--font-size-sm); color: var(--text-dark);">Explore Events</span>
          </a>
          <a href="profile.html" class="quick-action-btn">
            <i class="fa-solid fa-user"></i>
            <span class="font-weight-600" style="font-size: var(--font-size-sm); color: var(--text-dark);">My Profile</span>
          </a>
        </div>

        <div class="dashboard-grid">
          <div class="flex flex-column gap-3">
            <div class="card-modern">
              <div class="flex justify-between align-center mb-4">
                <h3 class="m-0" style="font-size: var(--font-size-lg);"><i class="fa-solid fa-user-secret text-secondary" style="margin-right: 0.5rem;"></i>Latest Confessions</h3>
                <a href="/confessions" class="text-primary font-weight-600" style="font-size: var(--font-size-xs);">View Timeline</a>
              </div>
              <div class="activity-list">
                <div class="activity-item">
                  <div class="activity-icon" style="background-color: rgba(79, 70, 229, 0.1); color: var(--secondary-color);"><i class="fa-solid fa-mask"></i></div>
                  <div class="activity-details">
                    <p style="margin-bottom: 0.25rem;">"Finally told my lab partner that I've been doing all the coding because their bugs give me anxiety. We laughed but it was a close call!"</p>
                    <span class="activity-time">12 minutes ago • Funny</span>
                  </div>
                </div>
                <div class="activity-item">
                  <div class="activity-icon" style="background-color: rgba(79, 70, 229, 0.1); color: var(--secondary-color);"><i class="fa-solid fa-mask"></i></div>
                  <div class="activity-details">
                    <p style="margin-bottom: 0.25rem;">"Shoutout to the library security staff who returned my notebook right before the microprocessors exam. You saved my semester GPA."</p>
                    <span class="activity-time">2 hours ago • College Life</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="card-modern">
              <div class="flex justify-between align-center mb-4">
                <h3 class="m-0" style="font-size: var(--font-size-lg);"><i class="fa-solid fa-binoculars text-warning" style="margin-right: 0.5rem;"></i>Recent Lost Items</h3>
                <a href="/lost" class="text-primary font-weight-600" style="font-size: var(--font-size-xs);">View All</a>
              </div>
              <div class="grid grid-2">
                <div class="card-modern" style="padding: 1rem; box-shadow: var(--shadow-sm); border: 1px solid var(--border-color);">
                  <div class="flex justify-between align-center mb-2">
                    <span class="badge badge-danger">Lost</span>
                    <span class="text-muted" style="font-size: 10px;">July 05</span>
                  </div>
                  <h4 class="mb-1" style="font-size: var(--font-size-sm);"><a href="/lost">Casio Calculator fx-991EX</a></h4>
                  <p class="text-muted" style="font-size: 0.8rem; margin-bottom: 0.75rem;">Left inside Room 302 of Lab Block C. Has yellow stickers.</p>
                  <div class="flex justify-between align-center text-muted" style="font-size: var(--font-size-xs); border-top: 1px solid var(--border-color); padding-top: 0.5rem;">
                    <span><i class="fa-solid fa-location-dot"></i> Lab Block C</span>
                    <span class="text-primary"><i class="fa-solid fa-comment"></i> Contact</span>
                  </div>
                </div>
                <div class="card-modern" style="padding: 1rem; box-shadow: var(--shadow-sm); border: 1px solid var(--border-color);">
                  <div class="flex justify-between align-center mb-2">
                    <span class="badge badge-success">Found</span>
                    <span class="text-muted" style="font-size: 10px;">July 04</span>
                  </div>
                  <h4 class="mb-1" style="font-size: var(--font-size-sm);"><a href="/lost">Black Hard Glasses Case</a></h4>
                  <p class="text-muted" style="font-size: 0.8rem; margin-bottom: 0.75rem;">Found near Cafeteria lawns bench. Handed to security block.</p>
                  <div class="flex justify-between align-center text-muted" style="font-size: var(--font-size-xs); border-top: 1px solid var(--border-color); padding-top: 0.5rem;">
                    <span><i class="fa-solid fa-location-dot"></i> Cafeteria Lawns</span>
                    <span class="text-primary"><i class="fa-solid fa-comment"></i> Contact</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="flex flex-column gap-3">
            <div class="card-modern">
              <div class="flex justify-between align-center mb-4">
                <h3 class="m-0" style="font-size: var(--font-size-lg);"><i class="fa-solid fa-calendar text-accent" style="margin-right: 0.5rem;"></i>Upcoming Events</h3>
                <a href="events.html" class="text-primary font-weight-600" style="font-size: var(--font-size-xs);">Explore</a>
              </div>
              <div class="flex flex-column gap-3">
                <div class="flex gap-2 align-center pb-2" style="border-bottom: 1px solid var(--border-color);">
                  <div style="background: var(--grad-accent); color: var(--text-white); width: 44px; height: 44px; border-radius: var(--radius-md); display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1.1;">
                    <span style="font-size: 0.85rem; font-weight: 700;">12</span>
                    <span style="font-size: 0.6rem; text-transform: uppercase;">Jul</span>
                  </div>
                  <div>
                    <h4 class="m-0" style="font-size: var(--font-size-sm);"><a href="events.html">Byte Code Hackathon</a></h4>
                    <span class="text-muted" style="font-size: var(--font-size-xs);"><i class="fa-solid fa-location-dot"></i> CSE Lab Block B • 10 AM</span>
                  </div>
                </div>
                <div class="flex gap-2 align-center pb-2" style="border-bottom: 1px solid var(--border-color);">
                  <div style="background: var(--grad-primary); color: var(--text-white); width: 44px; height: 44px; border-radius: var(--radius-md); display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1.1;">
                    <span style="font-size: 0.85rem; font-weight: 700;">18</span>
                    <span style="font-size: 0.6rem; text-transform: uppercase;">Jul</span>
                  </div>
                  <div>
                    <h4 class="m-0" style="font-size: var(--font-size-sm);"><a href="events.html">AI Seminar</a></h4>
                    <span class="text-muted" style="font-size: var(--font-size-xs);"><i class="fa-solid fa-location-dot"></i> Main Auditorium • 2 PM</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="card-modern" style="border-left: 4px solid var(--warning-color);">
              <h3 class="mb-2" style="font-size: var(--font-size-md);"><i class="fa-solid fa-triangle-exclamation text-warning" style="margin-right: 0.5rem;"></i>Respectful Space</h3>
              <p style="font-size: 0.85rem; color: var(--text-dark);">
                All confessions are anonymous. Please respect others and avoid abusive content. Abuse or harassment is subject to immediate moderation.
              </p>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>
</body>
</html>
