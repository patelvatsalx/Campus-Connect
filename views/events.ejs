<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Events - Campus Connect</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/pages.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
  <div class="app-container">
    <input type="checkbox" id="sidebar-toggle" class="sidebar-toggle" hidden>
    <aside class="sidebar">
      <div class="sidebar-header">
        <a href="/" class="sidebar-brand"><i class="fa-solid fa-graduation-cap"></i><span>Campus Connect</span></a>
        <label for="sidebar-toggle" class="sidebar-menu-btn"><i class="fa-solid fa-bars-staggered"></i></label>
      </div>
      <ul class="sidebar-nav">
        <li class="sidebar-item"><a href="/dashboard"><i class="fa-solid fa-chart-pie"></i><span>Dashboard</span></a></li>
        <li class="sidebar-item"><a href="/lost"><i class="fa-solid fa-magnifying-glass"></i><span>Lost & Found</span></a></li>
        <li class="sidebar-item active"><a href="/events"><i class="fa-solid fa-calendar-days"></i><span>Events</span></a></li>
        <li class="sidebar-item"><a href="/confessions"><i class="fa-solid fa-user-secret"></i><span>Confessions</span></a></li>
        <li class="sidebar-item" style="margin-top:auto;border-top:1px solid rgba(255,255,255,.05);padding-top:.5rem;"><a href="/settings"><i class="fa-solid fa-gear"></i><span>Settings</span></a></li>
      </ul>
    </aside>
    <div class="main-layout">
      <header class="navbar">
        <div class="flex align-center gap-2">
          <label for="sidebar-toggle" class="sidebar-menu-btn" style="color:var(--text-dark);display:block;margin-right:.5rem;"><i class="fa-solid fa-bars"></i></label>
          <div class="nav-search"><i class="fa-solid fa-magnifying-glass"></i><input type="text" placeholder="Search events..."></div>
        </div>
        <div class="nav-actions">
          <form action="/logout" method="POST" style="margin:0;"><button class="btn btn-ghost" type="submit">Logout</button></form>
        </div>
      </header>
      <main class="content animate-fade-in">
        <div class="page-header">
          <div class="page-title">
            <h1>Campus Events</h1>
            <p>Stay up to date with upcoming student activities and workshops.</p>
          </div>
        </div>
        <div class="grid grid-3">
          <% events.forEach((event) => { %>
            <div class="card-modern">
              <div class="flex justify-between align-center mb-3">
                <span class="badge badge-primary"><%= event.category %></span>
                <span class="text-muted" style="font-size:.75rem;"><%= event.date %></span>
              </div>
              <h3 class="mb-2"><%= event.title %></h3>
              <p class="text-muted" style="font-size:.9rem;">Location: <%= event.location %></p>
              <a href="#" class="btn btn-primary mt-3">Register</a>
            </div>
          <% }) %>
        </div>
      </main>
    </div>
  </div>
</body>
</html>
