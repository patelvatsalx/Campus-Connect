<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Settings - Campus Connect</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/pages.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
  <div class="app-container">
    <input type="checkbox" id="sidebar-toggle" class="sidebar-toggle" hidden>
    <aside class="sidebar">
      <div class="sidebar-header">
        <a href="/" class="sidebar-brand"><i class="fa-solid fa-graduation-cap"></i><span>Campus Connect</span></a>
        <label for="sidebar-toggle" class="sidebar-menu-btn"><i class="fa-solid fa-bars-staggered"></i></label>
      </div>
      <ul class="sidebar-nav">
        <li class="sidebar-item"><a href="/dashboard"><i class="fa-solid fa-chart-pie"></i><span>Dashboard</span></a></li>
        <li class="sidebar-item"><a href="/lost"><i class="fa-solid fa-magnifying-glass"></i><span>Lost & Found</span></a></li>
        <li class="sidebar-item"><a href="/events"><i class="fa-solid fa-calendar-days"></i><span>Events</span></a></li>
        <li class="sidebar-item"><a href="/confessions"><i class="fa-solid fa-user-secret"></i><span>Confessions</span></a></li>
        <li class="sidebar-item active" style="margin-top:auto;border-top:1px solid rgba(255,255,255,.05);padding-top:.5rem;"><a href="/settings"><i class="fa-solid fa-gear"></i><span>Settings</span></a></li>
      </ul>
    </aside>
    <div class="main-layout">
      <header class="navbar">
        <div class="flex align-center gap-2">
          <label for="sidebar-toggle" class="sidebar-menu-btn" style="color:var(--text-dark);display:block;margin-right:.5rem;"><i class="fa-solid fa-bars"></i></label>
        </div>
        <div class="nav-actions">
          <form action="/logout" method="POST" style="margin:0;"><button class="btn btn-ghost" type="submit">Logout</button></form>
        </div>
      </header>
      <main class="content animate-fade-in">
        <div class="page-header">
          <div class="page-title">
            <h1>Settings</h1>
            <p>Adjust account preferences and notification choices.</p>
          </div>
        </div>
        <div class="card-modern" style="padding:2rem;">
          <h3 class="mb-3">Account Preferences</h3>
          <div class="form-group">
            <label>Name</label>
            <input class="form-control" type="text" value="<%= user.username %>">
          </div>
          <div class="form-group">
            <label>Email</label>
            <input class="form-control" type="email" value="<%= user.email %>">
          </div>
          <button class="btn btn-primary" type="button">Save Changes</button>
        </div>
      </main>
    </div>
  </div>
</body>
</html>
